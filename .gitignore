# --- Secrets and local configuration ---------------------------------------
.env
.env.*
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# --- Node / Next.js --------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# --- Editors and OS --------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Local artifacts -------------------------------------------------------
*.log
tmp/
.scratch/

# --- Model weights ---------------------------------------------------------
# Embedding models are downloaded into a Docker volume (EMBEDDING_CACHE_DIR),
# not into the repository. These rules catch a local run configured to cache
# somewhere inside the tree: the weights are hundreds of megabytes of binary
# that Git must never take.
models/
.cache/huggingface/
*.safetensors
*.onnx
*.gguf
*.bin

# --- Uploaded documents ----------------------------------------------------
# Uploaded originals must never be committed: they are user data, and in this
# domain they are usually confidential. STORAGE_ROOT should point outside the
# repository entirely; these rules catch a misconfigured local run.
var/
data/
uploads/
*.pdf
!apps/api/tests/**/*.py

# The synthetic evaluation corpora are source, not user data: newly authored
# JSON with nothing confidential in it. The broad `data/` rule above was
# swallowing them, which left `evals/data/*.json` untracked even though
# `evals/dataset.py`, `evals/grounded_dataset.py`, and the retrieval and
# grounded integration tests all read them - so a fresh clone had a failing
# suite for a reason that was invisible in the diff. The directory has to be
# re-included before the files, because git will not descend into an excluded
# directory to find a negated pattern.
!apps/api/evals/data/
!apps/api/evals/data/*.json
