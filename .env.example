# ClaimTrace environment template.
#
#   cp .env.example .env
#
# Every value below is a safe local-development placeholder. Never commit a real
# .env: it is ignored by git. For anything beyond local development, generate a
# strong POSTGRES_PASSWORD and inject it from your secret store.

# --- Application ------------------------------------------------------------
APP_NAME=ClaimTrace API
APP_VERSION=0.1.0
# development | test | staging | production
ENVIRONMENT=development
# INFO | DEBUG | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# text (human readable) | json (structured)
LOG_FORMAT=text
API_V1_PREFIX=/api/v1

# --- CORS -------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# --- PostgreSQL -------------------------------------------------------------
# Local development placeholders only.
POSTGRES_USER=claimtrace
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=claimtrace
# Host used when running the API outside Docker. docker-compose overrides this
# with the "postgres" service name.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: full DSN override. When set it takes precedence over POSTGRES_* above.
# DATABASE_URL=postgresql+psycopg://claimtrace:change-me-local-only@localhost:5432/claimtrace

# --- Document ingestion -----------------------------------------------------
# Where uploaded originals are written. Inside Docker this is a named volume;
# it must never point inside the Git-tracked source tree.
STORAGE_ROOT=/data/uploads
# Maximum accepted upload, in bytes (20 MB).
UPLOAD_MAX_BYTES=20971520
# Comma-separated allow lists for the upload endpoint.
UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf
UPLOAD_ALLOWED_EXTENSIONS=.pdf
# A PDF yielding fewer characters than this in total is treated as scanned or
# image-only and recorded as failed - this phase does not perform OCR.
MIN_EXTRACTED_CHARACTERS=32

# --- Claim indexing: embeddings ---------------------------------------------
# "sentence-transformers" loads a real local model; "fake" is a deterministic
# hashing provider that downloads nothing. Use "fake" for offline environments
# and CI - it is not semantic, so retrieval quality will be poor by design.
EMBEDDING_PROVIDER=sentence-transformers
# Must produce vectors of EMBEDDING_DIMENSION. Changing to a model of a
# different width requires a new migration, not just a new value here.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Container path backed by the "model_cache" volume. Weights are downloaded once
# on first use; they are never committed and never baked into the image.
EMBEDDING_CACHE_DIR=/models
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
# The width the pgvector column was migrated with (revision 0004).
EMBEDDING_DIMENSION=384

# --- Claim retrieval ---------------------------------------------------------
# How many candidates each channel contributes before rank fusion.
DENSE_CANDIDATE_COUNT=30
LEXICAL_CANDIDATE_COUNT=30
# Reciprocal Rank Fusion constant: fused_score = sum(1 / (RRF_K + rank)).
# Larger values flatten the curve, so agreement between channels matters more
# than either channel's top position.
RRF_K=60
# Ceilings the API enforces on a search request.
SEARCH_TOP_K_MAX=50
SEARCH_QUERY_MAX_LENGTH=512

# --- Local LLM provider (Phase 4A-1) ----------------------------------------
# fake | ollama | openai_compatible
#
# "fake" is deterministic, needs no model and no network, and every endpoint
# works with it - including the diagnostics UI. It is the default so that
# `docker compose up` never depends on a model server being present. Switch to a
# real provider when you want real generation.
LLM_PROVIDER=fake

# --- Ollama ---
# The default points at an Ollama running on the HOST, which reuses models you
# have already pulled instead of downloading a second copy into a container
# volume. To use the optional bundled service instead:
#   docker compose --profile llm up -d ollama
#   docker compose exec ollama ollama pull qwen2.5:1.5b
# and set LLM_OLLAMA_BASE_URL=http://ollama:11434
LLM_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Small, multilingual (Korean included), instruction-tuned, ~1 GB, practical on
# CPU. Chosen to validate the provider boundary - not for analysis quality.
LLM_OLLAMA_MODEL=qwen2.5:1.5b
# Host port published by the optional "llm" profile service.
OLLAMA_PORT=11434

# --- OpenAI-compatible (vLLM, llama.cpp, LM Studio) ---
# For a LOCAL or private model server only. The hosted OpenAI service is not a
# supported target: unpublished patent text must not leave the deployment by
# default. Include the version prefix the server exposes, normally /v1.
LLM_OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
LLM_OPENAI_COMPATIBLE_MODEL=local-model
# Usually empty for a local server. Held as a secret: never logged, never
# serialised, never returned by any endpoint. Leave blank unless yours needs one.
LLM_OPENAI_COMPATIBLE_API_KEY=
# How strongly the OpenAI-compatible server can constrain JSON. Declared, not
# probed - a server that accepts response_format and ignores it looks identical
# to one that honours it until the output is validated.
#   native_json_schema      vLLM guided decoding (default)
#   native_json_object      valid JSON guaranteed, schema not enforced
#   prompt_constrained_json asked for in the prompt, validated on arrival
#   unsupported             structured output refused rather than faked
# Ollama's mode is fixed by its adapter, which enforces a schema natively.
LLM_STRUCTURED_OUTPUT_MODE=native_json_schema

# --- Timeouts, retries, and bounds ---
# Short connect so a wrong port fails fast; generous read because a small model
# on CPU genuinely takes this long. MAX bounds one whole call, retries included;
# a per-request timeout may lower it but never raise it.
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_READ_TIMEOUT_SECONDS=120
LLM_MAX_TIMEOUT_SECONDS=180
# Two attempts, not five: only failures that never reached the server are
# replayed, so a server that is down fails fast and clearly.
LLM_RETRY_MAX_ATTEMPTS=2
LLM_MAX_PROMPT_CHARACTERS=8000
LLM_MAX_OUTPUT_TOKENS=1024

# The /api/v1/llm/diagnostics/* endpoints generate text on demand, so they are
# development tooling. Leave blank to follow ENVIRONMENT - on in development,
# off everywhere else. Set true or false to override.
LLM_DIAGNOSTICS_ENABLED=

# --- Evidence-grounded generation (Phase 4A-2) -------------------------------
# Product surface rather than diagnostics, so it is on in every environment.
# Turn it off for a deployment that wants retrieval without generation.
GROUNDED_GENERATION_ENABLED=true

# How many retrieved claims may enter the prompt. Small on purpose: a local
# 1.5B model asked to pick citations from twenty claims picks worse than one
# asked to pick from six, and every extra claim is context spent on evidence
# retrieval already ranked below the claims above it.
GROUNDED_MAX_EVIDENCE_CANDIDATES=6

# Total rendered evidence characters. A claim that will not fit is dropped
# whole, never truncated - a half-included claim would still be citable, and the
# citation would resolve to text the model never saw. Sized to leave room for
# the instructions, the question, and a repair instruction inside
# LLM_MAX_PROMPT_CHARACTERS, so move the two together.
GROUNDED_MAX_EVIDENCE_CHARACTERS=5000
GROUNDED_MAX_QUESTION_CHARACTERS=512

# Post-generation ceilings. These duplicate the output schema's bounds on
# purpose: schema-constrained decoding enforces structure, not values, so the
# schema asks for at most eight statements and these are what check.
GROUNDED_MAX_STATEMENTS=8
GROUNDED_MAX_STATEMENT_CHARACTERS=600
GROUNDED_MAX_EVIDENCE_IDS_PER_STATEMENT=4

# Greedy decoding: an extraction task with a fixed output shape has no use for
# sampling diversity, and a deterministic temperature makes a weak answer
# reproducible instead of intermittent.
GROUNDED_TEMPERATURE=0.0
GROUNDED_MAX_OUTPUT_TOKENS=1024
# Longer than a diagnostics call - a grounded prompt carries several claims.
# Still bounded by LLM_MAX_TIMEOUT_SECONDS, which nothing may raise.
GROUNDED_TIMEOUT_SECONDS=150

# One bounded corrective attempt for an answer that broke a grounding rule
# (an unknown evidence id, a missing citation, contradictory flags). 0 disables
# repair. Above 1 buys very little: a model that ignores an explicit list of the
# only legal ids twice will not be talked round on the third pass.
GROUNDED_REPAIR_MAX_ATTEMPTS=1

# --- Published ports --------------------------------------------------------
API_PORT=8000
WEB_PORT=3000

# --- Web --------------------------------------------------------------------
# Used by the Next.js server runtime. Inside Docker the API is reachable by
# service name; outside Docker use http://localhost:8000.
API_INTERNAL_BASE_URL=http://api:8000
# Fallback, and the base URL any browser-side call would use. Only NEXT_PUBLIC_*
# variables reach the browser bundle - never put a credential behind that prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
