# --- Secrets and local configuration ---------------------------------------
.env
.env.*
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# --- Node / Next.js --------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# --- Editors and OS --------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Local artifacts -------------------------------------------------------
*.log
tmp/
.scratch/

# --- Uploaded documents ----------------------------------------------------
# Uploaded originals must never be committed: they are user data, and in this
# domain they are usually confidential. STORAGE_ROOT should point outside the
# repository entirely; these rules catch a misconfigured local run.
var/
data/
uploads/
*.pdf
!apps/api/tests/**/*.py
